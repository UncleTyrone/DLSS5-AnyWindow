namespace Magpie {
	runtimeclass ScalingModeBoolParameter : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		Boolean Value;
		// Bind to CheckBox.Content
		Object Label { get; };
		Boolean IsEnabled { get; };
	}

	runtimeclass ScalingModeFloatParameter : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		Double Value;
		String Label { get; };
		String ValueText { get; };
		Double Minimum { get; };
		Double Maximum { get; };
		Double Step { get; };
		Boolean IsEnabled { get; };
		Double Opacity { get; };
	}

	runtimeclass EffectParametersViewModel {
		UInt32 ScalingModeIdx;
		UInt32 EffectIdx;

		IVector<IInspectable> BoolParams { get; };
		IVector<IInspectable> FloatParams { get; };
		IVector<IInspectable> FilterBoolParams { get; };
		IVector<IInspectable> FilterFloatParams { get; };
		IVector<IInspectable> Pass1Params { get; };
		IVector<IInspectable> Pass2Params { get; };
		IVector<IInspectable> Pass3Params { get; };
		IVector<IInspectable> Pass4Params { get; };
		IVector<IInspectable> GuidanceParams { get; };
		Boolean HasBoolParams { get; };
		Boolean HasFloatParams { get; };
		Boolean HasFilterParams { get; };
		Boolean HasPass1Params { get; };
		Boolean HasPass2Params { get; };
		Boolean HasPass3Params { get; };
		Boolean HasPass4Params { get; };
		Boolean HasGuidanceParams { get; };
	}
}
